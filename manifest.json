{
  "manifest_version": 3,
  "name": "H5P Weekly Extractor",
  "version": "1.3",
  "description": "Detects H5P lecture content on CODL Moodle pages, downloads notes (.txt) and slides (.pdf), and keeps a personal library you can export as one zip.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["activeTab", "scripting", "downloads", "offscreen", "storage", "unlimitedStorage"],
  "host_permissions": ["https://online.codl.lk/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "H5P Weekly Extractor",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["fonts/SpaceGrotesk.woff2"],
      "matches": ["https://online.codl.lk/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["https://online.codl.lk/mod/hvp/*"],
      "js": ["inject.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": ["https://online.codl.lk/mod/hvp/*"],
      "js": ["parser.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}