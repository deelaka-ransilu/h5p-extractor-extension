{
  "manifest_version": 3,
  "name": "H5P Weekly Extractor",
  "version": "1.5",
  "description": "Detects H5P lecture content on CODL Moodle pages, downloads notes (.txt) and slides (.pdf), and keeps a personal library you can export as one zip.",
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "permissions": ["downloads", "offscreen", "storage", "unlimitedStorage"],
  "host_permissions": ["https://online.codl.lk/*"],
  "background": { "service_worker": "src/background/background.js" },
  "action": {
    "default_title": "Open the H5P library",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["assets/fonts/SpaceGrotesk.woff2"],
      "matches": ["https://online.codl.lk/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["https://online.codl.lk/mod/hvp/*"],
      "js": ["src/content/inject.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": ["https://online.codl.lk/mod/hvp/*"],
      "js": ["src/content/parser.js", "src/content/content.js"],
      "run_at": "document_idle"
    }
  ]
}